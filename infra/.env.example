# Copy to .env and replace every value before running.
SUPERSET_SECRET_KEY=change-me
# MySQL on the host: containers reach it through the Docker gateway alias,
# 127.0.0.1 inside a container is the container itself. Local test uses root/root;
# change the credentials and database names before production.
SUPERSET_METADATA_URI=mysql+pymysql://root:root@host.docker.internal:3306/assistant_superset?charset=utf8mb4
DEMO_DB_URI=mysql+pymysql://root:root@host.docker.internal:3306/assistant_demo?charset=utf8mb4
DEMO_SCHEMA=

# Host-published ports; container ports stay fixed (Superset 8088, Agent 28088,
# MCP 5008). Change AGENT_CORS_ORIGINS and WEBDRIVER_BASEURL_USER_FRIENDLY
# together with SUPERSET_HTTP_PORT.
SUPERSET_HTTP_PORT=8088
AGENT_HTTP_PORT=28088
MCP_HTTP_PORT=25008

REDIS_HOST=redis
REDIS_PORT=6379

# 邮件（SMTP）。当前是占位值，换真实地址后重建 superset / superset-worker /
# superset-beat 生效；SSL 与 STARTTLS 按服务商要求二选一。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=placeholder@example.com
SMTP_PASSWORD=placeholder
SMTP_MAIL_FROM=placeholder@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_SSL_SERVER_AUTH=true
SMTP_TIMEOUT=30
# Alerts & Reports 邮件主题前缀（默认 "[Superset] "）。
EMAIL_REPORTS_SUBJECT_PREFIX=[Superset]

# Alerts & Reports 的任务队列与报表链接地址。
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
WEBDRIVER_BASEURL=http://superset:8088/
WEBDRIVER_BASEURL_USER_FRIENDLY=http://localhost:8088/

MCP_PORT=5008
MCP_JWT_SECRET=change-me-64-hex
MCP_JWT_ALGORITHM=HS256
MCP_JWT_ISSUER=assistant
MCP_JWT_AUDIENCE=superset-mcp

AGENT_PORT=28088
AGENT_MCP_URL=http://superset-mcp:5008/mcp
AGENT_TOKEN_TTL=300
AGENT_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_ROWS=500
AGENT_AUDIT_PATH=/app/runtime/audit.jsonl
AGENT_LOG_DIR=/app/runtime/logs
AGENT_LOG_RETENTION_DAYS=14
AGENT_LOG_LEVEL=INFO
AGENT_MOCK_LLM=true

ADMIN_DB_URL=mysql+pymysql://root:root@host.docker.internal:3306/assistant_admin?charset=utf8mb4
ADMIN_STATIC_DIR=/app/admin_static
ADMIN_SECRET_KEY=change-me-32-hex
ADMIN_TICKET_SECRET=change-me-32-hex
ADMIN_TICKET_AUDIENCE=assistant-admin
ADMIN_TICKET_ISSUER=assistant
ADMIN_SESSION_SECRET=change-me-32-hex
ADMIN_SESSION_TTL=1800
ADMIN_COOKIE_SECURE=false
ADMIN_RETENTION_DAYS=90
ADMIN_RETENTION_INTERVAL_SECONDS=86400

# Per-user limits; 0 disables a limit. Admin roles bypass these limits.
AGENT_USER_RATE_PER_MINUTE=20
AGENT_USER_DAILY_REQUESTS=200
AGENT_USER_DAILY_TOKENS=1000000
AGENT_USER_DAILY_COST=5.0
ASSISTANT_ADMIN_URL=

# A configured LLM_MODEL takes precedence over AGENT_MOCK_LLM.
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=...
# MiniCPM: set true to suppress <think> prefixes via chat_template_kwargs.
LLM_DISABLE_THINKING=false
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@example.com
